# Build context for the `backend` service (docker-compose.yml -> context: ./backend)
# The Dockerfile only needs: package.json, package-lock.json, tsconfig.json, src/

# Dependencies - reinstalled inside the image (npm ci / npm install)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output - regenerated by `npx tsc` in the builder stage
dist/
build/
*.tsbuildinfo

# Environment / secrets - never bake these into an image
.env
.env.*

# Runtime state - bind-mounted at runtime, must not be baked in
data/
logs/
*.db
*.sqlite
*.sqlite3
backups/

# Docker files themselves
Dockerfile
Dockerfile.*
.dockerignore
docker-compose*.yml
docker-compose*.yaml

# VCS / editors / OS
.git/
.gitignore
.github/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Tests, linting and docs - not needed to build or run the image
coverage/
.nyc_output/
.eslintrc.json
.eslintrc.*
.prettierrc
.prettierrc.*
*.md

# Temporary files
*.tmp
*.bak
