# Root build context.
# NOTE: docker-compose.yml builds from ./backend and ./frontend, so those
# contexts use backend/.dockerignore and frontend/.dockerignore. This file
# only applies to a build run from the repository root.

# VCS
.git/
.gitignore
.github/

# Documentation and screenshots
docs/
*.md
!README.md

# Environment / secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build artifacts
dist/
build/
coverage/
.nyc_output/
*.tsbuildinfo

# Local runtime state and databases - bind-mounted at runtime, never baked in
data/
backups/
mongo_docker/mongodb_data/
*.db
*.sqlite
*.sqlite3

# Docker / editors / OS
Dockerfile
Dockerfile.*
.dockerignore
docker-compose*.yml
docker-compose*.yaml
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Logs
logs/
*.log

# Temporary
*.tmp
*.bak
