# Build context for the `frontend` service (docker-compose.yml -> context: ./frontend)
# The Dockerfile does `COPY . .`, so everything not listed here is sent to the daemon.
# Keep: index.html, src/, public/, package.json, package-lock.json,
#       vite.config.ts, tsconfig*.json, tailwind.config.js, postcss.config.js

# Dependencies - reinstalled inside the image (npm ci / npm install)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output - regenerated by `npm run build` in the builder stage
dist/
build/
.vite/
*.tsbuildinfo

# Environment / secrets - Vite inlines env vars into the bundle, so never ship these.
# The image gets its values from the VITE_API_URL / VITE_WS_URL build args.
.env
.env.*

# Docker files themselves
Dockerfile
Dockerfile.*
.dockerignore
docker-compose*.yml
docker-compose*.yaml

# Not used by this image: nginx runs as its own service from ../nginx/nginx.conf
nginx.conf

# VCS / editors / OS
.git/
.gitignore
.github/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Tests, linting and docs
coverage/
.nyc_output/
.eslintrc.json
.eslintrc.*
.prettierrc
.prettierrc.*
*.md

# Temporary files
*.tmp
*.bak
